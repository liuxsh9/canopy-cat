{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CanopyCat",
  "version": "../../package.json",
  "identifier": "io.github.liuxsh9.canopycat",
  "build": {
    "beforeDevCommand": "vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../dist",
    "windows": { "staticVCRuntime": true }
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "CanopyCat",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "skipTaskbar": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
